# ══════════════════════════════════════════════════════════════════════════════
# Alpha Signal Engine — Environment Configuration
# Copy to .env and fill in your API keys. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Mode ─────────────────────────────────────────────────────────────────────
# Options: research | backtest | paper | live
AGENT_MODE=paper

# ── Asset Classes ────────────────────────────────────────────────────────────
ENABLE_STOCKS=true
ENABLE_CRYPTO=true

# ── Binance (Crypto) ────────────────────────────────────────────────────────
# No API key needed for public candle data (read-only)
# Add keys only if you need private endpoints (account, orders)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_ENV=live
# USA USERS: Binance.com is blocked in the US. Set region to "us" to use Binance.US
# Note: Binance.US has NO futures API — futures trading disabled for US region
# Options: global | us
BINANCE_REGION=global

# ── Alpaca (US Stocks + ETFs) ───────────────────────────────────────────────
# Sign up free at https://alpaca.markets (paper trading account)
# Required for stock data. Leave blank to run crypto-only.
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Watchlists ───────────────────────────────────────────────────────────────
# Stocks (32 symbols: mega-cap tech, banks, ETFs, bonds, gold)
STOCK_WATCHLIST=AAPL,MSFT,NVDA,AMD,AMZN,GOOGL,META,TSLA,AVGO,SMCI,MU,ARM,PLTR,TSM,JPM,GS,BAC,MS,NFLX,SHOP,SNOW,CRM,UBER,SPY,QQQ,IWM,DIA,SMH,XLF,XLK,TLT,GLD

# Crypto Spot (29 symbols)
CRYPTO_WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,NEARUSDT,SUIUSDT,ATOMUSDT,UNIUSDT,AAVEUSDT,INJUSDT,ARBUSDT,OPUSDT,IMXUSDT,PEPEUSDT,SHIBUSDT,LTCUSDT,APTUSDT,STXUSDT,FETUSDT,RENDERUSDT,TONUSDT,BCHUSDT,POLUSDT

# Crypto Futures (20 symbols — enables SHORT positions in bearish markets)
FUTURES_WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,DOTUSDT,AVAXUSDT,POLUSDT,LTCUSDT,NEARUSDT,SUIUSDT,APTUSDT,ARBUSDT,INJUSDT,FETUSDT,RENDERUSDT,TONUSDT
ENABLE_FUTURES=true

# ── Signal Thresholds ────────────────────────────────────────────────────────
MIN_CONFLUENCE_SCORE=0.65
MIN_REWARD_RISK=2.0
MAX_ACTIVE_SIGNALS=100
MAX_SIGNALS_PER_SYMBOL=5

# ── Risk Guardrails ─────────────────────────────────────────────────────────
MAX_RISK_PER_SIGNAL_PCT=2.0
MAX_CORRELATED_SIGNALS=4

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_METRICS=true

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_AUDIT_LOG=true
DATA_QUALITY_STRICT=false
