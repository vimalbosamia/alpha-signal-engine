# ══════════════════════════════════════════════════════════════════════════════
# AI Trading Signal Agent — Environment Configuration
# Copy to .env and fill in real values.  NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Deployment Mode ───────────────────────────────────────────────────────────
# Options: research | backtest | paper | live
AGENT_MODE=paper

# ── Asset Classes to Monitor ─────────────────────────────────────────────────
ENABLE_STOCKS=true
ENABLE_CRYPTO=true

# ── Stocks: Alpaca ────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# Feed: iex (free) | sip (paid)
ALPACA_DATA_FEED=iex

# ── Crypto: Binance ───────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
# Options: live | testnet
BINANCE_ENV=testnet
BINANCE_TESTNET_URL=https://testnet.binance.vision

# ── Crypto: Coinbase (optional backup) ───────────────────────────────────────
COINBASE_API_KEY=
COINBASE_SECRET_KEY=
COINBASE_ENABLED=false

# ── Signal Output ─────────────────────────────────────────────────────────────
# Minimum confluence score to emit a signal (0.0–1.0)
MIN_CONFLUENCE_SCORE=0.65
# Minimum reward:risk ratio for a signal to be actionable
MIN_REWARD_RISK=2.0
# Maximum active signals across all symbols
MAX_ACTIVE_SIGNALS=20

# ── Watchlists ────────────────────────────────────────────────────────────────
STOCK_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL,AMD,SPY,QQQ
CRYPTO_WATCHLIST=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT

# ── Risk Guardrails ───────────────────────────────────────────────────────────
MAX_RISK_PER_SIGNAL_PCT=2.0
MAX_SIGNALS_PER_SYMBOL=2
MAX_CORRELATED_SIGNALS=4

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
ALERT_EMAIL=vimalbosamia@gmail.com

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_AUDIT_LOG=true
ENABLE_REPLAY=true
ENABLE_PATTERN_CACHE=true
DATA_QUALITY_STRICT=false     # true = block signals on warnings; false = log only
